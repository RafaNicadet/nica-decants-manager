# Copia este archivo a .env.local y completa los valores de tu proyecto.
# Son credenciales públicas para el navegador; RLS debe estar habilitado.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_CLAVE_PUBLICABLE_O_ANON

# NUNCA agregues aquí service_role, secret keys ni la contraseña de PostgreSQL.